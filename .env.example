# ── MediFlow Frontend — Environment / Configuration Reference ───────────────
#
# This is a vanilla-JS PWA with no build step.
# There is no .env file loaded automatically; instead, configure constants
# directly in app.js (or inject them via your hosting platform's build vars).
#
# ── API & Socket Configuration ──────────────────────────────────────────────
#
# Set these constants near the top of app.js:
#   const API_BASE   = 'https://<your-backend-host>/api';
#   const SOCKET_URL = 'https://<your-backend-host>';
#
# ── OTP Authentication ───────────────────────────────────────────────────────
#
# The frontend posts JSON to these backend endpoints:
#   POST /api/auth/send-otp    body: { "phone": "<10-digit number>" }
#   POST /api/auth/verify      body: { "phone": "<10-digit number>", "otp": "<6-digit code>" }
#
# Required backend .env variables for OTP to work:
#   TWILIO_ACCOUNT_SID=<your-twilio-sid>      # Twilio account SID (or your SMS provider)
#   TWILIO_AUTH_TOKEN=<your-twilio-token>      # Twilio auth token
#   TWILIO_PHONE_NUMBER=<+1XXXXXXXXXX>         # Verified sender number
#   OTP_EXPIRY_SECONDS=300                     # OTP validity window (default: 5 min)
#
# CORS: Ensure the backend allows requests from your frontend origin, e.g.:
#   ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:3000
#
# Rate limiting: The backend should enforce a per-phone cooldown (e.g. 1 OTP
# per 60 seconds). The frontend handles HTTP 429 responses gracefully and
# displays a user-friendly message without using browser alert().
#
# ── Other Configuration ──────────────────────────────────────────────────────
# API_BASE and SOCKET_URL are also set at the top of app.js.
